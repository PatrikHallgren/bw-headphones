[Unit]
Description=B&W Px7 S3 control bridge for Omarchy
After=graphical-session.target bluetooth.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/px7s3d
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
