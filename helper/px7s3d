#!/usr/bin/env python3
"""User-level BlueZ/GATT bridge for the Bowers & Wilkins Px7 S3.

The daemon owns the system-bus Bluetooth session and exposes only a small
JSON-over-UNIX-socket API to ``px7s3ctl``. The vendor protocol is isolated in
``bw_headphones.py`` and discovery happens at runtime; bluetoothctl is never
used.
"""

from __future__ import annotations

from pathlib import Path
import json
import os
import socket
import sys
import threading
import time
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
from bw_headphones import (  # noqa: E402
    ANC_MODES,
    NOTIFICATION_UUID,
    REQUEST_UUID,
    RESPONSE_UUID,
    base_state,
    command,
    decode_frame,
    encode_request,
    matching_name,
    retry,
    state_path,
    write_state,
)

try:
    import gi  # type: ignore

    gi.require_version("Gio", "2.0")
    gi.require_version("GLib", "2.0")
    from gi.repository import Gio, GLib  # type: ignore
except ImportError:  # pragma: no cover - unsupported hosts
    Gio = None
    GLib = None


SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid()))) / "bw-headphones.sock"
SYSTEM_BUS_TIMEOUT_MS = 5000


def unpack(value: Any) -> Any:
    return value.unpack() if hasattr(value, "unpack") else value


def prop(properties: dict[str, Any], name: str, default: Any = None) -> Any:
    return unpack(properties.get(name, default))


class BlueZVendorTransport:
    """Runtime-discovered B&W RPC transport over BlueZ GATT."""

    def __init__(self, owner: "Daemon"):
        self.owner = owner
        self.bus = None
        self.device_path = None
        self.device_proxy = None
        self.battery_proxy = None
        self.request_proxy = None
        self.response_proxy = None
        self.notification_proxy = None
        self.ready = False
        self._refresh_lock = threading.Lock()

    def error(self, message: str) -> None:
        self.owner.publish(last_error=message, transport_ready=False)

    def _proxy(self, path: str, interface: str):
        return Gio.DBusProxy.new_sync(
            self.bus,
            Gio.DBusProxyFlags.NONE,
            None,
            "org.bluez",
            path,
            interface,
            None,
        )

    def start(self) -> None:
        if Gio is None:
            self.error("PyGObject is required for BlueZ control")
            return
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.refresh()
        except Exception as exc:
            self.error(f"BlueZ unavailable: {exc}")

    def _managed_objects(self) -> dict[str, Any]:
        manager = self._proxy("/", "org.freedesktop.DBus.ObjectManager")
        result = manager.call_sync(
            "GetManagedObjects", None, Gio.DBusCallFlags.NONE, SYSTEM_BUS_TIMEOUT_MS, None
        )
        return result.unpack()[0]

    def _find_objects(self, objects: dict[str, Any], interface: str):
        for path, interfaces in objects.items():
            if interface in interfaces:
                yield path, interfaces[interface]

    def _select_device(self, objects: dict[str, Any]):
        selected = os.environ.get("BW_HEADPHONES_ADDRESS", "").replace("-", ":").lower()
        fallback = None
        for path, properties in self._find_objects(objects, "org.bluez.Device1"):
            address = str(prop(properties, "Address", "")).lower()
            name = str(prop(properties, "Name", ""))
            alias = str(prop(properties, "Alias", ""))
            if selected and address == selected:
                return path, properties
            if matching_name(name) or matching_name(alias):
                if bool(prop(properties, "Connected", False)):
                    return path, properties
                fallback = (path, properties)
        return fallback

    def _set_device_state(self, properties: dict[str, Any]) -> None:
        address = str(prop(properties, "Address", ""))
        name = str(prop(properties, "Alias", "") or prop(properties, "Name", "Px7 S3"))
        connected = bool(prop(properties, "Connected", False))
        self.owner.publish(address=address, name=name or "Px7 S3", connected=connected)

    def _attach_device(self, path: str, properties: dict[str, Any]) -> None:
        if path != self.device_path:
            self.device_path = path
            self.device_proxy = self._proxy(path, "org.bluez.Device1")
            self.device_proxy.connect("g-properties-changed", self._device_changed)
        self._set_device_state(properties)

    def _device_changed(self, _proxy, changed, _invalidated) -> None:
        values = {key: unpack(value) for key, value in changed.items()}
        updates = {}
        if "Address" in values:
            updates["address"] = str(values["Address"])
        if "Alias" in values or "Name" in values:
            updates["name"] = str(values.get("Alias") or values.get("Name") or "Px7 S3")
        if "Connected" in values:
            updates["connected"] = bool(values["Connected"])
        if updates:
            self.owner.publish(**updates)
        if values.get("Connected") is False:
            self.ready = False
            self.owner.publish(transport_ready=False, capabilities=[])
        elif values.get("ServicesResolved") is True:
            self.refresh()

    def _battery_changed(self, _proxy, changed, _invalidated) -> None:
        if "Percentage" in changed:
            level = int(unpack(changed["Percentage"]))
            self.owner.publish(battery={
                "level": max(-1, min(100, level)),
                "charging": self.owner.state["battery"].get("charging", False),
            })

    def _find_characteristics(self, objects: dict[str, Any]) -> dict[str, tuple[str, dict[str, Any]]]:
        found: dict[str, tuple[str, dict[str, Any]]] = {}
        for path, properties in self._find_objects(objects, "org.bluez.GattCharacteristic1"):
            service = str(prop(properties, "Service", ""))
            if self.device_path and not service.startswith(self.device_path):
                continue
            uuid = str(prop(properties, "UUID", "")).lower()
            if uuid in (REQUEST_UUID, RESPONSE_UUID, NOTIFICATION_UUID):
                found[uuid] = (path, properties)
        return found

    def _attach_characteristics(self, objects: dict[str, Any]) -> None:
        found = self._find_characteristics(objects)
        if REQUEST_UUID not in found or RESPONSE_UUID not in found:
            self.ready = False
            self.owner.publish(transport_ready=False, capabilities=[])
            return

        request_path, _ = found[REQUEST_UUID]
        response_path, _ = found[RESPONSE_UUID]
        if self.request_proxy is None or self.request_proxy.get_object_path() != request_path:
            self.request_proxy = self._proxy(request_path, "org.bluez.GattCharacteristic1")
        if self.response_proxy is None or self.response_proxy.get_object_path() != response_path:
            self.response_proxy = self._proxy(response_path, "org.bluez.GattCharacteristic1")
            self.response_proxy.connect("g-properties-changed", self._characteristic_changed)
        if NOTIFICATION_UUID in found:
            notification_path, _ = found[NOTIFICATION_UUID]
            self.notification_proxy = self._proxy(notification_path, "org.bluez.GattCharacteristic1")
            self.notification_proxy.connect("g-properties-changed", self._characteristic_changed)

        try:
            self.response_proxy.call_sync(
                "StartNotify", None, Gio.DBusCallFlags.NONE, SYSTEM_BUS_TIMEOUT_MS, None
            )
        except Exception as exc:
            self.ready = False
            self.error(f"Px7 S3 notifications unavailable: {exc}")
            return

        self.ready = True
        self.owner.publish(transport_ready=True, last_error="")
        for namespace, command_id in ((0x03, 0x01), (0x08, 0x0C), (0x08, 0x0B), (0x04, 0x0C), (0x05, 0x06), (0x04, 0x14), (0x02, 0x01)):
            try:
                self.write(encode_request(namespace, command_id))
            except Exception as exc:
                self.owner.publish(last_error=f"Initial Px7 S3 query failed: {exc}")
                break

    def refresh(self) -> bool:
        if Gio is None or self.bus is None:
            return False
        if not self._refresh_lock.acquire(blocking=False):
            return False
        try:
            objects = self._managed_objects()
            selected = self._select_device(objects)
            if not selected:
                self.device_path = None
                self.ready = False
                self.owner.publish(connected=False, transport_ready=False, capabilities=[])
                return True
            path, properties = selected
            self._attach_device(path, properties)
            connected = bool(prop(properties, "Connected", False))
            if not connected:
                self.ready = False
                self.owner.publish(transport_ready=False, capabilities=[])
                return True
            battery = objects.get(path, {}).get("org.bluez.Battery1", {})
            if battery:
                if self.battery_proxy is None:
                    self.battery_proxy = self._proxy(path, "org.bluez.Battery1")
                    self.battery_proxy.connect("g-properties-changed", self._battery_changed)
                self.owner.publish(battery={
                    "level": int(prop(battery, "Percentage", -1)),
                    "charging": False,
                })
            self._attach_characteristics(objects)
            return True
        except Exception as exc:
            self.error(f"BlueZ discovery failed: {exc}")
            return False
        finally:
            self._refresh_lock.release()

    def _characteristic_changed(self, _proxy, changed, _invalidated) -> None:
        value = changed.get("Value")
        if value is None:
            return
        try:
            decoded = decode_frame(bytes(unpack(value)))
            if decoded["error"]:
                self.owner.publish(last_error=f"Px7 S3 command error {decoded['error']}")
                return
            self._apply(decoded["namespace"], decoded["command_id"], decoded["payload"])
        except Exception as exc:
            self.owner.publish(last_error=f"Malformed Px7 S3 response: {exc}")

    def _apply(self, namespace: int, command_id: int, payload: Any) -> None:
        key = (namespace, command_id)
        if key == (0x03, 0x01) and isinstance(payload, int) and payload in range(3):
            self.owner.publish(anc_mode=ANC_MODES[payload], capabilities=self.owner.add_capability("anc"), last_error="")
        elif key == (0x08, 0x0C) and isinstance(payload, int):
            self.owner.publish(battery={"level": max(-1, min(100, payload)), "charging": self.owner.state["battery"].get("charging", False)}, last_error="")
        elif key == (0x08, 0x0B) and isinstance(payload, bool):
            self.owner.publish(battery={"level": self.owner.state["battery"].get("level", -1), "charging": payload}, last_error="")
        elif key == (0x04, 0x0C):
            self.owner.publish(audio_source=str(payload), last_error="")
        elif key == (0x05, 0x06):
            self.owner.publish(codec=str(payload), last_error="")
        elif key == (0x04, 0x14):
            self.owner.publish(sampling_rate=str(payload), last_error="")
        elif key == (0x02, 0x01):
            self.owner.publish(firmware=str(payload), last_error="")

    def write(self, packet: bytes) -> None:
        if not self.ready or self.request_proxy is None:
            raise RuntimeError("Px7 S3 vendor transport is unavailable")
        def write_once():
            return self.request_proxy.call_sync(
                "WriteValue",
                GLib.Variant("(aya{sv})", (packet, {})),
                Gio.DBusCallFlags.NONE,
                SYSTEM_BUS_TIMEOUT_MS,
                None,
            )

        retry(write_once, attempts=2)

    def set_anc(self, mode: str) -> tuple[bool, str]:
        namespace, command_id, value = command(mode)
        try:
            self.write(encode_request(namespace, command_id, value))
            self.owner.publish(anc_mode=mode, last_error="")
            if GLib is not None:
                GLib.timeout_add(350, self.read_anc)
            return True, ""
        except Exception as exc:
            message = str(exc)
            self.owner.publish(last_error=message)
            return False, message

    def read_anc(self):
        try:
            self.write(encode_request(0x03, 0x01))
        except Exception:
            pass
        return False


class Daemon:
    def __init__(self):
        self.state = base_state()
        self.lock = threading.RLock()
        self.stop = False
        self.transport = BlueZVendorTransport(self)

    def add_capability(self, capability: str) -> list[str]:
        with self.lock:
            values = list(self.state.get("capabilities", []))
            if capability not in values:
                values.append(capability)
            return values

    def publish(self, **updates) -> None:
        with self.lock:
            self.state.update(updates)
            self.state["updated_at"] = int(time.time())
            write_state(self.state)

    def handle(self, conn: socket.socket) -> None:
        try:
            request = json.loads(conn.recv(4096).decode("utf-8"))
            if request.get("op") == "set-anc":
                mode = str(request.get("mode", ""))
                command(mode)
                ok, error = self.transport.set_anc(mode)
                response = {"ok": ok}
                if error:
                    response["error"] = error
            elif request.get("op") == "refresh":
                response = {"ok": self.transport.refresh()}
            else:
                response = {"ok": False, "error": "unknown request"}
            conn.sendall((json.dumps(response) + "\n").encode())
        except Exception as exc:
            conn.sendall((json.dumps({"ok": False, "error": str(exc)}) + "\n").encode())
        finally:
            conn.close()

    def run(self) -> None:
        SOCKET.parent.mkdir(parents=True, exist_ok=True)
        try:
            SOCKET.unlink()
        except FileNotFoundError:
            pass
        write_state(self.state)

        def socket_loop() -> None:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
                server.bind(str(SOCKET))
                os.chmod(SOCKET, 0o600)
                server.listen(4)
                server.settimeout(1)
                while not self.stop:
                    try:
                        conn, _ = server.accept()
                    except socket.timeout:
                        continue
                    threading.Thread(target=self.handle, args=(conn,), daemon=True).start()

        threading.Thread(target=socket_loop, daemon=True).start()
        self.transport.start()
        if GLib is not None and Gio is not None and self.transport.bus is not None:
            GLib.timeout_add_seconds(5, self._periodic_refresh)
            GLib.MainLoop().run()
            return

        while not self.stop:
            time.sleep(1)

    def _periodic_refresh(self):
        self.transport.refresh()
        return not self.stop


if __name__ == "__main__":
    Daemon().run()
